# ==============================================================================
# Enterprise API Governance System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values to match your local database.
# Do NOT commit your actual '.env' file with production passwords to Git.
# ==============================================================================

# Database Connection Settings
# Option A: Local MySQL 8.0 Server (Default for dedicated MySQL installations)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=api_management

# Option B: XAMPP / MariaDB (Default XAMPP installation uses user 'root' with NO password)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=api_management

# Flask Application Secret Key
# Generate a random 32-byte secret key (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
